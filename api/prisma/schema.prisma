// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model HealthCheck {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
}

enum Role {
  HR
  CANDIDATE
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         Role
  firstName    String
  lastName     String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshToken     RefreshToken?
  resetTokens      PasswordResetToken[]
  candidateProfile CandidateProfile?

  candidateSessions   InterviewSession[] @relation("CandidateSessions")
  interviewerSessions InterviewSession[] @relation("InterviewerSessions")
  feedbackAuthored    Feedback[]         @relation("FeedbackAuthor")
  feedbackReceived    Feedback[]         @relation("CandidateFeedback")
}

// One-to-one with User, but Postgres can't enforce "CANDIDATE role <=> profile
// exists" as a schema constraint without a trigger — that invariant is
// enforced where the row is created (UsersService.createCandidate's
// transaction), not here. See api/README.md.
model CandidateProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone           String?
  currentRole     String?
  yearsExperience Int?
  targetRole      String?
  resumeUrl       String?
  notes           String?
  skills          String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum Recommendation {
  HIRE
  NO_HIRE
  MAYBE
}

model InterviewSession {
  id              String          @id @default(uuid())
  candidateId     String
  candidate       User            @relation("CandidateSessions", fields: [candidateId], references: [id], onDelete: Cascade)
  interviewerId   String
  interviewer     User            @relation("InterviewerSessions", fields: [interviewerId], references: [id], onDelete: Cascade)
  scheduledAt     DateTime
  durationMinutes Int
  position        String
  status          InterviewStatus @default(SCHEDULED)
  meetingLink     String?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  feedback Feedback?

  @@index([candidateId])
  @@index([interviewerId])
}

// One feedback per session (sessionId is unique below), authored by the
// interviewer. isPublished gates candidate visibility — see the Feedback
// module's service for the enforcement (candidates never see drafts).
model Feedback {
  id             String           @id @default(uuid())
  sessionId      String           @unique
  session        InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  authorId       String
  author         User             @relation("FeedbackAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  candidateId    String
  candidate      User             @relation("CandidateFeedback", fields: [candidateId], references: [id], onDelete: Cascade)
  rating         Int?
  recommendation Recommendation
  comments       String
  isPublished    Boolean          @default(false)
  publishedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([candidateId])
}

model RefreshToken {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String   @unique
  previousTokenHash String?  @unique
  expiresAt         DateTime
  createdAt         DateTime @default(now())
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
