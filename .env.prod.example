# Template for /opt/intervivo/.env.prod on the VPS (docker-compose.prod.yml).
# Copy this to .env.prod on the server and fill in real values; never commit
# the real file. Keep these secrets DISTINCT from local dev's api/.env.

# ─── Database ───────────────────────────────────────────────────────────────
POSTGRES_USER=intervivo
POSTGRES_PASSWORD=change_me
POSTGRES_DB=intervivo
DATABASE_URL="postgresql://intervivo:change_me@intervivo_postgres:5432/intervivo?schema=public"

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me
REDIS_URL="redis://:change_me@intervivo_redis:6379"

# ─── JWT — MUST differ from the dev stack's secret ────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars

# ─── Docker / Registry ───────────────────────────────────────────────────────
# CI tags images by branch (docker/metadata-action type=ref,event=branch), so
# this stack always pulls the image built from main. GHCR image paths must be
# all-lowercase — `docker compose pull` does not lowercase this for you.
GITHUB_REPO=radur92/intervivo
IMAGE_TAG=main

# ─── API ─────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
CORS_ORIGIN=https://intervivo.rr-dev.ro
